//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "code_actions_on_format": {
    "source.fixAll.eslint": true,
  },
  "base_keymap": "VSCode",
  "status_bar": {
    "experimental.show": false,
  },
  "tabs": {
    "file_icons": true,
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "minimap": {
    "show": "auto",
    "thumb": "always",
  },
  "selection_highlight": false,
  "current_line_highlight": "all",
  "cursor_shape": "bar",
  "buffer_font_fallbacks": [
    "Fira Code",
    "Menlo",
    "Monaco",
    "Courier New",
    "monospace",
  ],
  "file_types": {
    "shellscript": ["*.symlink"],
  },
  "auto_indent_on_paste": false,
  "show_edit_predictions": true,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "agent": {
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
    },
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "theme": "Ayu Dark",
  "buffer_font_size": 14.0,
  "ui_font_size": 14,
  "ui_font_family": "Inter Variable",
  "buffer_font_family": "FiraCode Nerd Font",
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "formatter": ["prettier"],
  "enable_language_server": true,
  "languages": {
    "TypeScript": {
      "language_servers": ["tsgo"],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
  },
  "terminal": {
    "font_size": 13,
  },
  "experimental.theme_overrides": {
    "modified": "#928272",
    "created": "#427265",
    "warning.background": "#423222",
    "warning.border": "#524232",
    "scrollbar.thumb.background": "#333",
    "terminal.ansi.bright_black": "#888",
    "hint": "#444", // git blame etc
    "predictive": "#444",
    "panel.background": "#1a1a1a",
    "terminal.background": "#1a1a1a",
    "tab_bar.background": "#1a1a1a",
    "tab.active_background": "#2a2a2a",
    // "pane_group.border": "#ff0000",
    //   "editor.background": "#222",
    //   "background": "#222",
    //   "terminal.background": "#222",
    // "title_bar.background": "#222",
    //   "border": "#333",
    //   "editor.gutter.background": "#222",
    //   "panel.background": "#222",
    //   "info.background": "#222",
    //   "tab_bar.background": "#333",
    //   "tab.active_background": "#444",
    //   "tab.inactive_background": "#333",
    //   "status_bar.background": "#333",
    //   "toolbar.background": "#222",
    //   "editor.active_line.background": "#1d1d1d",
    //   "element.selected": "#F00",
    "players": [
      {
        "selection": "#36301d",
      },
    ],
    //   "syntax": {
    //     "comment": {
    //       "font_style": "italic"
    //     }
    //   }
  },
}
