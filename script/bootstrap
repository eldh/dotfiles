#!/usr/bin/env bash
#
# bootstrap — first-run entry point.
#
# All setup is idempotent and lives in bin/dot now, so this just runs the full
# install (symlinks, gitconfig prompt, Homebrew, npm, and macOS defaults).
# After the first run, use `dot` directly (it's on your PATH via bin/).

cd "$(dirname "$0")/.." && exec ./bin/dot --all
