#!/bin/bash
#
# wt — create a git worktree and initialize it, like a Conductor workspace.
#
# Usage: wt [--no-setup] [--branch <branch>] <name> [base]
#        wt setup [dir]
#        wt prune [-n|--dry-run]
#        wt workspace <dir> <name> <desc> [prompt-file]
#        wt linear
#
#   name  Name of the worktree, and of the branch unless --branch
#         gives another one. If the branch already exists (locally or
#         on origin) the worktree checks it out and continues on it;
#         otherwise a new branch is created.
#   base  Branch to start a new branch from. Default: the origin
#         default branch. Ignored when the branch already exists.
#
#   --branch <branch>  Use this branch name instead of <name>. The
#                      worktree directory still uses <name>.
#
# The worktree is created at ~/Code/worktrees/<repo>/<name>.
# If the repo has a setup script in .conductor/settings.toml, it runs
# in the new worktree with CONDUCTOR_ROOT_PATH set to the main repo.
# With --no-setup the setup script is skipped; `wt setup [dir]` runs
# it later for an existing worktree (dir defaults to the current one).
#
# `wt prune` removes the worktrees of merged PRs. PRs are squash merged,
# so `git branch --merged` cannot find them; instead, after a
# `git fetch --prune`, a branch whose upstream is gone had its remote
# branch deleted by GitHub when the PR merged. Worktrees with
# uncommitted changes and branches that were never pushed stay.
# With -n (or --dry-run) nothing changes.
#
# `wt workspace` is internal plumbing for the zsh `wt` function: it opens
# the cmux workspace for a worktree that the function just created.
#
# `wt linear` is the entry point for Linear's custom coding-tool script
# (see linear/coding-tools.json). Linear runs it as a bare executable,
# with the issue in LINEAR_PROMPT, LINEAR_ISSUE_IDENTIFIER,
# LINEAR_ISSUE_BRANCH_NAME and LINEAR_WORK_DIR, so it does on its own
# what the zsh function does around a pasted prompt.
#
# The path of the new worktree is written to stdout, as are the paths of
# the pruned worktrees. All other output goes to stderr, so a shell
# function can capture the paths and cd to (or close) them.

set -e

# Resolve the repository, in case we run from another worktree. Sets
# root (the current worktree), main (the main repo root) and repo.
resolve_repo() {
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "wt: not inside a git repository" >&2
    exit 1
  }
  main="$(git -C "$root" worktree list | head -n1 | awk '{print $1}')"
  repo="$(basename "$main")"
}

# Run the Conductor setup script for the worktree at $1, if the repo
# has one.
run_setup() {
  dir="$1"
  main="$(git -C "$dir" worktree list | head -n1 | awk '{print $1}')"
  setup=""
  for f in "$main/.conductor/settings.local.toml" "$main/.conductor/settings.toml"; do
    [ -f "$f" ] || continue
    setup="$(sed -n 's/^setup[[:space:]]*=[[:space:]]*"\(.*\)"$/\1/p' "$f" | head -n1)"
    [ -n "$setup" ] && break
  done

  if [ -z "$setup" ]; then
    echo "wt: no setup script found" >&2
    return 0
  fi

  echo "wt: running setup: $setup" >&2
  (cd "$dir" && CONDUCTOR_ROOT_PATH="$main" bash -c "$setup" 1>&2)
}

if [ "$1" = "setup" ]; then
  dir="${2:-$PWD}"
  git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || {
    echo "wt: $dir is not inside a git repository" >&2
    exit 1
  }
  run_setup "$dir"
  exit 0
fi

# Remove the worktree at $1 (branch $2, named $3 below the worktree
# base directory), its branch and its cached prompt, and write its path
# to stdout. In a dry run it only tells what it would do.
prune_worktree() {
  wt_dir="$1"
  wt_ref="$2"
  wt_rel="$3"

  if [ -n "$dry_run" ]; then
    echo "wt: would prune $wt_rel (branch $wt_ref)" >&2
    n_pruned=$((n_pruned + 1))
    echo "$wt_dir"
    return 0
  fi

  echo "wt: pruning $wt_rel (branch $wt_ref)" >&2
  if ! git -C "$main" worktree remove "$wt_dir" 1>&2; then
    echo "wt: could not remove $wt_rel, keeping branch $wt_ref" >&2
    n_kept=$((n_kept + 1))
    return 0
  fi
  git -C "$main" branch -D "$wt_ref" 1>&2 ||
    echo "wt: could not delete branch $wt_ref" >&2
  # Cached prompts only exist for paste-mode names, which have no slash.
  rm -f "$HOME/.cache/wt/$wt_rel.md"
  n_pruned=$((n_pruned + 1))
  echo "$wt_dir"
}

# Decide what to do with the worktree at $1 on branch $2 ("" when the
# worktree is detached), and do it.
classify_worktree() {
  cw_dir="$1"
  cw_ref="$2"

  case "$cw_dir" in
    "$base_dir"/*) ;;
    *) return 0 ;;
  esac
  cw_rel="${cw_dir#"$base_dir"/}"

  if [ -z "$cw_ref" ]; then
    echo "wt: skip $cw_rel: detached HEAD" >&2
    n_skipped=$((n_skipped + 1))
    return 0
  fi

  # Never remove the worktree we are standing in.
  if [ "$cw_dir" = "$root" ]; then
    echo "wt: skip $cw_rel: this is the current worktree" >&2
    n_skipped=$((n_skipped + 1))
    return 0
  fi

  if [ -n "$(git -C "$cw_dir" status --porcelain 2>/dev/null)" ]; then
    echo "wt: skip $cw_rel: uncommitted changes" >&2
    n_skipped=$((n_skipped + 1))
    return 0
  fi

  # An upstream that is gone means the remote branch was deleted, which
  # GitHub does when the PR merges.
  cw_track="$(git -C "$main" for-each-ref \
    --format='%(upstream)%09%(upstream:track)' "refs/heads/$cw_ref")"
  cw_upstream="${cw_track%%	*}"
  cw_state="${cw_track#*	}"

  if [ -z "$cw_upstream" ]; then
    echo "wt: skip $cw_rel: never pushed" >&2
    n_skipped=$((n_skipped + 1))
    return 0
  fi

  if [ "$cw_state" = "[gone]" ]; then
    prune_worktree "$cw_dir" "$cw_ref" "$cw_rel"
    return 0
  fi

  # The remote branch is still there. The PR may still have merged, so
  # ask GitHub when gh is available.
  if command -v gh >/dev/null 2>&1; then
    cw_pr="$( (cd "$main" && gh pr view "$cw_ref" --json state --jq .state) \
      2>/dev/null </dev/null || true)"
    if [ "$cw_pr" = "MERGED" ]; then
      prune_worktree "$cw_dir" "$cw_ref" "$cw_rel"
      return 0
    fi
  fi

  echo "wt: keep $cw_rel: PR not merged (upstream still exists)" >&2
  n_kept=$((n_kept + 1))
}

if [ "$1" = "prune" ]; then
  dry_run=""
  case "$2" in
    -n|--dry-run) dry_run=1 ;;
    "") ;;
    *)
      echo "usage: wt prune [-n|--dry-run]" >&2
      exit 1
      ;;
  esac

  resolve_repo
  base_dir="$HOME/Code/worktrees/$repo"

  git -C "$main" fetch --prune --quiet origin ||
    echo "wt: fetch failed, going on with the remote state on disk" >&2

  n_pruned=0
  n_kept=0
  n_skipped=0

  # Read the worktrees first: the loop removes some of them.
  worktrees="$(git -C "$main" worktree list --porcelain)"
  path=""
  ref=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) path="${line#worktree }" ;;
      "branch refs/heads/"*) ref="${line#branch refs/heads/}" ;;
      "")
        if [ -n "$path" ]; then
          classify_worktree "$path" "$ref"
        fi
        path=""
        ref=""
        ;;
    esac
  done <<EOF
$worktrees

EOF

  if [ -n "$dry_run" ]; then
    echo "wt: would prune $n_pruned, kept $n_kept, skipped $n_skipped" >&2
  else
    git -C "$main" worktree prune 1>&2
    echo "wt: pruned $n_pruned, kept $n_kept, skipped $n_skipped" >&2
  fi
  exit 0
fi

# Open a cmux workspace for the worktree at $1, named $2 and described
# by $3: claude on the left, `wt setup` top-right (with a browser tab
# behind it, for $WT_BROWSER_URL or localhost:8080), spare shell below.
# With a prompt file in $4, claude starts with that prompt; the command
# reaches cmux with `$(cat …)` unexpanded, so the pane's own shell reads
# the file and quoting in the prompt cannot break out.
open_workspace() {
  ws_dir="$1"
  ws_name="$2"
  ws_desc="$3"
  ws_prompt="$4"

  if [ -n "$ws_prompt" ]; then
    ws_left="$(printf 'claude --permission-mode plan \\"$(cat %s)\\"' "$ws_prompt")"
  else
    ws_left='claude --permission-mode plan'
  fi

  # The browser is listed first so the setup terminal, listed last, is the
  # selected tab while setup runs.
  ws_layout="$(printf '{"direction":"horizontal","split":0.5,"children":[{"pane":{"surfaces":[{"type":"terminal","command":"%s"}]}},{"direction":"vertical","split":0.5,"children":[{"pane":{"surfaces":[{"type":"browser","url":"%s"},{"type":"terminal","command":"command wt setup"}]}},{"pane":{"surfaces":[{"type":"terminal"}]}}]}]}' \
    "$ws_left" "${WT_BROWSER_URL:-http://localhost:8080}")"

  cmux workspace create \
    --name "$ws_name" \
    --description "$ws_desc" \
    --cwd "$ws_dir" \
    --focus true \
    --layout "$ws_layout"
}

if [ "$1" = "workspace" ]; then
  shift
  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "usage: wt workspace <dir> <name> <desc> [prompt-file]" >&2
    exit 1
  fi
  open_workspace "$1" "$2" "$3" "$4"
  exit 0
fi

# Say $1 in a macOS notification. Linear runs the script without a
# terminal, so stderr alone reaches nobody.
linear_notify() {
  command -v osascript >/dev/null 2>&1 || return 0
  osascript -e "display notification \"$1\" with title \"wt\"" >/dev/null 2>&1 || true
}

# Give up on the `wt linear` run, telling $1 on stderr and in a notification.
linear_fail() {
  echo "wt: $1" >&2
  linear_notify "$1"
  exit 1
}

if [ "$1" = "linear" ]; then
  # The create path below re-runs this script from another directory, so
  # resolve it to an absolute path while we are still where we started.
  lin_self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"

  # Linear launches the script through a generated file in $TMPDIR, opened
  # in the default terminal. When that terminal is cmux, the run itself
  # sits in a throwaway workspace; remember it so it can be closed on
  # success. The temp-dir check keeps a manual `wt linear` from a real
  # workspace safe.
  lin_host_ws=""
  case "$PWD" in
    /var/folders/*|/private/var/folders/*|"${TMPDIR%/}"*)
      lin_host_ws="$CMUX_WORKSPACE_ID"
      ;;
  esac

  # Linear spawns the script without a login shell, so machine-local
  # settings like $WT_BROWSER_URL are not in the environment yet.
  if [ -z "$WT_BROWSER_URL" ] && [ -f "$HOME/.localrc" ]; then
    . "$HOME/.localrc"
  fi

  # Prefer the directory Linear passed; fall back to $WT_LINEAR_DIR (from
  # ~/.localrc) and then the main work repo, so the config does not have to
  # request LINEAR_WORK_DIR and Linear does not have to show a folder picker.
  lin_dir="${LINEAR_WORK_DIR:-${WT_LINEAR_DIR:-$HOME/Code/linear-app}}"
  cd "$lin_dir" 2>/dev/null || linear_fail "cannot enter $lin_dir"
  git rev-parse --show-toplevel >/dev/null 2>&1 ||
    linear_fail "$lin_dir is not inside a git repository"

  lin_branch="$LINEAR_ISSUE_BRANCH_NAME"
  [ -n "$lin_branch" ] || linear_fail "LINEAR_ISSUE_BRANCH_NAME is not set"
  lin_issue="$LINEAR_ISSUE_IDENTIFIER"
  # eldh/lin-82174-some-title -> some-title
  lin_name="$(printf '%s' "${lin_branch##*/}" | sed -E 's/^lin-[0-9]+-//')"
  lin_title="$(printf '%s' "$LINEAR_PROMPT" |
    sed -n -E 's|.*<title>(.*)</title>.*|\1|p' | head -n1)"

  resolve_repo
  lin_dest="$HOME/Code/worktrees/$repo/$lin_name"
  lin_cache="$HOME/.cache/wt/$lin_name.md"

  mkdir -p "$HOME/.cache/wt"
  printf '%s\n' "$LINEAR_PROMPT" > "$lin_cache" ||
    linear_fail "could not write $lin_cache"

  # Re-triggering an issue from Linear reopens a workspace for the
  # worktree it already has, instead of failing on the existing directory.
  if [ -e "$lin_dest" ]; then
    echo "wt: reusing existing worktree" >&2
  else
    lin_dest="$("$lin_self" --no-setup --branch "$lin_branch" "$lin_name")" ||
      linear_fail "could not create a worktree for $lin_branch"
  fi

  command -v cmux >/dev/null 2>&1 || linear_fail "cmux is not installed"
  open_workspace "$lin_dest" "${lin_title:-${lin_issue:-$lin_name}}" \
    "${lin_issue:-$lin_name}" "$lin_cache" ||
    linear_fail "could not open a cmux workspace for $lin_name"

  linear_notify "Opened ${lin_issue:-$lin_name}: $lin_name"

  # Closing the hosting workspace kills this script's own pane, so it is
  # the last thing that happens.
  if [ -n "$lin_host_ws" ]; then
    cmux workspace close --workspace "$lin_host_ws" >/dev/null 2>&1 || true
  fi
  exit 0
fi

no_setup=""
branch=""
while [ $# -gt 0 ]; do
  case "$1" in
    --no-setup)
      no_setup=1
      shift
      ;;
    --branch)
      branch="$2"
      if [ -z "$branch" ]; then
        echo "wt: --branch needs a branch name" >&2
        exit 1
      fi
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

name="$1"
if [ -z "$name" ]; then
  echo "usage: wt [--no-setup] [--branch <branch>] <name> [base]" >&2
  echo "       wt setup [dir]" >&2
  echo "       wt prune [-n|--dry-run]" >&2
  echo "       wt linear" >&2
  exit 1
fi
branch="${branch:-$name}"

resolve_repo
dest="$HOME/Code/worktrees/$repo/$name"

if [ -e "$dest" ]; then
  echo "wt: $dest already exists" >&2
  exit 1
fi

mkdir -p "$(dirname "$dest")"

# If the branch already exists, pick it up instead of creating a new one.
if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
  [ -n "$2" ] && echo "wt: branch $branch already exists, ignoring base $2" >&2
  echo "wt: creating $dest (existing branch $branch)" >&2
  git -C "$main" worktree add "$dest" "$branch" 1>&2
elif git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$branch" ||
     git -C "$main" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
  [ -n "$2" ] && echo "wt: branch $branch already exists on origin, ignoring base $2" >&2
  echo "wt: fetching branch $branch from origin..." >&2
  git -C "$main" fetch --quiet origin "$branch"
  echo "wt: creating $dest (branch $branch tracking origin/$branch)" >&2
  git -C "$main" worktree add --track -b "$branch" "$dest" "origin/$branch" 1>&2
else
  base="$2"
  if [ -z "$base" ]; then
    base="$(git -C "$main" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    base="${base:-HEAD}"
  fi

  # Refresh the base branch if it is a remote-tracking ref.
  case "$base" in
    origin/*)
      echo "wt: fetching ${base#origin/}..." >&2
      git -C "$main" fetch --quiet origin "${base#origin/}" || true
      ;;
  esac

  echo "wt: creating $dest (branch $branch from $base)" >&2
  git -C "$main" worktree add -b "$branch" "$dest" "$base" 1>&2
fi

if [ -z "$no_setup" ]; then
  run_setup "$dest"
fi

echo "$dest"
