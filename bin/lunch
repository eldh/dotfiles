#!/usr/bin/env bash
# lunch — display today's lunch menus from Restaurang Logen and Ulls Restaurang
set -euo pipefail

fetch_and_parse() {
  python3 << 'PYEOF'
import sys, re, locale, datetime, html as htmlmod

# --- Date setup ---
now = datetime.datetime.now()
weekday = now.weekday()  # 0=Mon .. 6=Sun
is_weekend = weekday >= 5

if is_weekend:
    # Show next Monday
    days_ahead = 7 - weekday
    target = now + datetime.timedelta(days=days_ahead)
else:
    target = now

day_idx = target.weekday()
swedish_days = ["Måndag", "Tisdag", "Onsdag", "Torsdag", "Fredag"]
english_days = ["monday", "tuesday", "wednesday", "thursday", "friday"]
day_name_sv = swedish_days[day_idx]
day_name_en = english_days[day_idx]
iso_week = target.isocalendar()[1]
date_str = target.strftime("%d/%m")

if is_weekend:
    header = f"📅  Dagens lunch — {day_name_sv} {date_str} (v. {iso_week}) [visar måndag — det är helg!]"
else:
    header = f"📅  Dagens lunch — {day_name_sv} {date_str} (v. {iso_week})"

print(header)
print()

# --- Fetch pages in parallel using curl ---
import subprocess, threading

logen_html = [None]
ulls_html = [None]

def fetch_logen():
    r = subprocess.run(
        ["curl", "-sL", "--max-time", "10", "https://www.nordrest.se/restaurang/restaurang-logen/"],
        capture_output=True, text=True
    )
    logen_html[0] = r.stdout

def fetch_ulls():
    r = subprocess.run(
        ["curl", "-sL", "--max-time", "10", "https://www.ullsrestaurang.se/17/3/veckans-lunch/"],
        capture_output=True, text=True
    )
    ulls_html[0] = r.stdout

t1 = threading.Thread(target=fetch_logen)
t2 = threading.Thread(target=fetch_ulls)
t1.start(); t2.start()
t1.join(); t2.join()

# --- Parse Logen ---
def parse_logen(raw):
    if not raw:
        return None, None, None, []

    # Extract prices
    price = None
    student_price = None
    m = re.search(r'<strong>Lunchpris:</strong>\s*<span>\s*(\d+)\s*kr', raw)
    if m:
        price = m.group(1)
    m = re.search(r'<strong>Student:</strong>\s*<span>\s*(\d+)\s*kr', raw)
    if m:
        student_price = m.group(1)

    # Week number
    week = None
    m = re.search(r'id="dynamic-week-number"[^>]*>v\.\s*(\d+)', raw)
    if m:
        week = m.group(1)

    # Find today's dishes directly — search for the day header followed by
    # its ratter-list. The accordion-header contains the day name, then
    # the accordion-content has a ul.ratter-list with li.ratter items.
    pattern = (
        r'<div class="accordion-header">\s*' + re.escape(day_name_sv) +
        r'.*?<ul class="ratter-list">(.*?)</ul>'
    )
    day_match = re.search(pattern, raw, re.DOTALL)

    dishes = []
    if day_match:
        ratter_html = day_match.group(1)
        for li in re.finditer(r'<li class="ratter"[^>]*>(.*?)</li>', ratter_html, re.DOTALL):
            text = li.group(1)
            # Remove span.co2-value and noscript blocks (including content)
            text = re.sub(r'<span class="co2-value"[^>]*>.*?</span>', '', text, flags=re.DOTALL)
            text = re.sub(r'<noscript>.*?</noscript>', '', text, flags=re.DOTALL)
            text = re.sub(r'<[^>]+>', '', text)
            text = htmlmod.unescape(text).strip()
            text = re.sub(r'\s+', ' ', text)
            if text:
                dishes.append(text)

    return price, student_price, week, dishes


# --- Parse Ulls ---
def parse_ulls(raw):
    # The site uses a "castit" menu widget: week panels
    # (div.castit-weekpanel[data-week]) contain section.castit-day per
    # weekday, with dish text in data-sv attributes.
    if not raw:
        return None, []

    def clean(s):
        s = htmlmod.unescape(s)
        return re.sub(r'\s+', ' ', s).strip()

    # Pick the panel for the target week, else the active one, else the page.
    week = None
    section = raw
    panels = re.split(r'<div class="castit-weekpanel', raw)[1:]
    active = None
    for p in panels:
        attrs = p.split('>', 1)[0]
        wm = re.search(r'data-week="(\d+)"', attrs)
        if wm and int(wm.group(1)) == iso_week:
            section = p
            week = wm.group(1)
            break
        if 'is-active' in attrs and active is None:
            active = (p, wm.group(1) if wm else None)
    else:
        if active:
            section, week = active

    dishes = []
    for day_html in re.split(r'<section class="castit-day', section)[1:]:
        day_html = day_html.split('</section>')[0]
        tm = re.search(r'castit-day__title.*?data-sv="([^"]*)"', day_html, re.DOTALL)
        if not tm or clean(tm.group(1)) != day_name_sv:
            continue
        for wrap in re.split(r'<div class="castit-dish-wrap">', day_html)[1:]:
            title = re.search(r'castit-dish__title"[^>]*data-sv="([^"]*)"', wrap)
            desc = re.search(r'castit-dish__desc"[^>]*data-sv="([^"]*)"', wrap)
            if not title:
                continue
            text = clean(title.group(1))
            if not text or text.startswith("Veckans kaka"):
                continue
            if desc and clean(desc.group(1)):
                text += f" — {clean(desc.group(1))}"
            dishes.append(text)
        break

    return week, dishes


# --- Output ---
price, student_price, logen_week, logen_dishes = parse_logen(logen_html[0])

price_str = ""
if price:
    price_str = f"{price} kr"
    if student_price:
        price_str += f" / student {student_price} kr"
else:
    price_str = "?"

print(f"🍽️  Restaurang Logen ({price_str})")
if logen_dishes:
    for d in logen_dishes:
        print(f"  • {d}")
else:
    print("  (ingen meny hittades)")
print()

ulls_week, ulls_dishes = parse_ulls(ulls_html[0])
print(f"🍽️  Ulls Restaurang (125 kr)")
if ulls_dishes:
    for d in ulls_dishes:
        print(f"  • {d}")
else:
    print("  (ingen meny hittades)")

PYEOF
}

fetch_and_parse
