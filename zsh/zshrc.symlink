###############################################################################
# Environment & path
###############################################################################

# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/dotfiles
export DOTFILES=$ZSH

# your project folder that we can `c [tab]` to
export PROJECTS=$HOME/Code

export EDITOR=micro

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

export PNPM_HOME="$HOME/Library/pnpm"

# One list, deduplicated by `typeset -U`; first occurrence of a dir wins.
typeset -U path
path=(
  $PNPM_HOME
  /opt/homebrew/opt/node@24/bin
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /usr/local/sbin
  $ZSH/bin
  $HOME/.opencode/bin
  $path
)

export MACOSX_DEPLOYMENT_TARGET=15.0

export LSCOLORS="exfxcxdxbxegedabagacad"
export CLICOLOR=true

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

# Generated for envman. Do not edit.
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"

# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# opam environment
if command -v opam > /dev/null; then
  eval $(opam env)
fi

###############################################################################
# Shell options
###############################################################################

setopt NO_BG_NICE # don't nice background tasks
setopt NO_HUP
setopt NO_LIST_BEEP
setopt LOCAL_OPTIONS # allow functions to have local options
setopt LOCAL_TRAPS # allow functions to have local traps
setopt HIST_VERIFY
setopt SHARE_HISTORY # share history between sessions
setopt EXTENDED_HISTORY # add timestamps to history
setopt PROMPT_SUBST
setopt CORRECT
setopt COMPLETE_IN_WORD
setopt IGNORE_EOF
setopt APPEND_HISTORY # adds history
setopt INC_APPEND_HISTORY # adds history incrementally
setopt HIST_IGNORE_ALL_DUPS # don't record dupes in history
setopt HIST_REDUCE_BLANKS

# don't expand aliases _before_ completion has finished
#   like: git comm-[tab]
setopt COMPLETE_ALIASES

###############################################################################
# Completion
###############################################################################

fpath=($ZSH/functions $fpath)

# autoload the function files (everything that isn't a _completion file)
for f in $ZSH/functions/[^_]*(N.:t); do autoload -U $f; done

autoload -Uz compinit && compinit

# matches case insensitive for lowercase
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# pasting with tabs doesn't perform completion
zstyle ':completion:*' insert-tab pending

###############################################################################
# Keybindings
###############################################################################
# NOTE: the up/down arrow binds live in the plugin section below, because they
# have to come after zsh-history-substring-search is sourced.

bindkey '^[^[[D' backward-word
bindkey '^[^[[C' forward-word
bindkey '^[[5D' beginning-of-line
bindkey '^[[5C' end-of-line
bindkey '^[[3~' delete-char
bindkey '^?' backward-delete-char

###############################################################################
# Aliases
###############################################################################

alias cls='clear' # Good 'ol Clear Screen command
alias reload="exec $SHELL -l"
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias l="ls -lF -G"
alias la="ls -laF -G"
alias ls="command ls -G"

alias ios='open -a simulator'

# git
alias g='git'
alias gl='git pull --prune'
alias glog="git log --graph --pretty=format:'%Cred%h%Creset %an: %s - %Creset %C(yellow)%d%Creset %Cgreen(%cr)%Creset' --abbrev-commit --date=relative"
alias gp='git push origin HEAD'

# Remove `+` and `-` from start of diff lines; just rely upon color.
alias gd='git diff --color | sed "s/^\([^-+ ]*\)[-+ ]/\\1/" | less -r'

alias gaa='git add --all'
alias gc='git commit'
alias gca='git commit -a'
alias gcm='git commit -m'
alias gcb='git copy-branch-name'
alias gb='git branch'
alias gco='git checkout'
alias gac='git add -A && git commit -m'
alias gcaa='git commit -v -a --amend'
alias gpl='git pull --rebase'
alias gprune='git branch --merged | grep -v "\*" | grep -v "master" | grep -v "develop" | grep -v "staging" | xargs -n 1 git branch -d'
alias gpn='git push --set-upstream origin $(git rev-parse --abbrev-ref HEAD)'
alias grem='git rebase --autostash --autosquash master'
alias grea='git rebase --abort'
alias grec='git rebase --continue'
alias greset='git reset --hard'
alias gst='git status -sb'
alias stash='git stash'
alias pop='git stash pop'
alias yolo='git add --all && git commit --amend && git push -f'

###############################################################################
# Functions
###############################################################################

# prevent yarn from running in non-yarn projects
yarn() {
  if [ -e package-lock.json ]; then
    echo "⚠️  This is a npm project. Why don't you use "npm" ⁉️"
  elif [ -e pnpm-lock.yaml ]; then
    echo "⚠️  This is a pnpm project. Why don't you use "pnpm" ⁉️"
  else
    command yarn $@
  fi
}

# Create a worktree with bin/wt, then cd into it.
#
# Inside cmux, the setup script runs in the background instead:
# a new pane opens below the current one with claude on the left,
# the setup running top-right, and a spare shell bottom-right.
wt() {
  if [[ "$1" == setup ]]; then
    command wt "$@"
    return
  fi

  local dir
  if [[ -n "$CMUX_WORKSPACE_ID" ]] && command -v cmux >/dev/null; then
    dir="$(command wt --no-setup "$@")" || return
    cd "$dir" || return
    _wt_cmux_layout "$dir"
  else
    dir="$(command wt "$@")" || return
    cd "$dir"
  fi
}

# Pull a string value out of pretty-printed `cmux --json` output.
_wt_json() {
  sed -n "s/.*\"$1\" *: *\"\([^\"]*\)\".*/\1/p" | head -n1
}

_wt_cmux_layout() {
  local dir="$1" ws="$CMUX_WORKSPACE_ID"
  local out left_pane left_surf tr_pane tr_surf br_surf

  out="$(cmux --json new-pane --direction down --workspace "$ws")" || return
  left_pane="$(print -r -- "$out" | _wt_json pane_ref)"
  left_surf="$(print -r -- "$out" | _wt_json surface_ref)"

  out="$(cmux --json new-split right --workspace "$ws" --pane "$left_pane")" || return
  tr_pane="$(print -r -- "$out" | _wt_json pane_ref)"
  tr_surf="$(print -r -- "$out" | _wt_json surface_ref)"

  out="$(cmux --json new-split down --workspace "$ws" --pane "$tr_pane")" || return
  br_surf="$(print -r -- "$out" | _wt_json surface_ref)"

  # Give the new shells a beat to start before typing into them.
  sleep 0.3
  cmux send --workspace "$ws" --surface "$tr_surf" "cd ${(q)dir} && command wt setup"$'\n'
  cmux send --workspace "$ws" --surface "$br_surf" "cd ${(q)dir}"$'\n'
  cmux send --workspace "$ws" --surface "$left_surf" "cd ${(q)dir} && claude"$'\n'
  cmux focus-pane --workspace "$ws" --pane "$left_pane"
}

###############################################################################
# Plugins (order matters)
###############################################################################

# Abbreviation support
source /opt/homebrew/share/zsh-abbr/zsh-abbr.zsh

# Fish style history search
source /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# Auto suggestions
# The plugin defaults to fg=8, which resolves through the terminal palette.
# Pin an explicit grey instead so the colour is the same everywhere.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#767676'
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# When zsh-syntax-highlighting is absent, zsh-history-substring-search installs
# a stand-in _zsh_highlight() that empties region_highlight on every printable
# key, and hooks it into zle-line-pre-redraw. That wipes the autosuggestion's
# colour too, so the suggestion lost its grey from the second character on.
# Keep the autosuggestion's entry and drop the rest, which is all the stand-in
# was meant to do. Skip this entirely if real syntax highlighting is loaded.
if (( ! ${+ZSH_HIGHLIGHT_VERSION} )); then
  _zsh_highlight() {
    if [[ $KEYS == [[:print:]] ]]; then
      region_highlight=("${(@M)region_highlight:#*${ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE}*}")
    fi
  }
fi

###############################################################################
# Prompt
###############################################################################

eval "$(starship init zsh)"
